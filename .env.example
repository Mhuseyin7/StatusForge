# Copy to .env and replace all values before public deployment.
APP_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
DATABASE_URL=postgresql+psycopg://statusforge:statusforge@postgres:5432/statusforge
REDIS_URL=redis://redis:6379/0
SECRET_KEY=replace-with-a-64-character-random-secret-before-production
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
ALLOW_PRIVATE_MONITORS=false
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
POSTGRES_DB=statusforge
POSTGRES_USER=statusforge
POSTGRES_PASSWORD=statusforge

